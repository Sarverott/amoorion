  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "handle": {
            "type": "string",
            "title": "Handle"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "handle"
        ],
        "title": "Account",
        "description": "Who speaks on a platform."
      },
      "AccountStatus": {
        "properties": {
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing",
            "default": []
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "ready"
        ],
        "title": "AccountStatus",
        "description": "Whether a platform is ready: its missing secrets by name, never by value."
      },
      "Capability": {
        "type": "string",
        "enum": [
          "post",
          "read",
          "reply",
          "delete"
        ],
        "title": "Capability",
        "description": "What a platform can do; a method asks for one before calling the plugin."
      },
      "ComposeParams": {
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt"
          },
          "system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System",
            "description": "how the model should behave"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "else llm/model of the vault"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "ComposeParams",
        "description": "What to ask the model, and optionally how it should behave and which model."
      },
      "Composition": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "model"
        ],
        "title": "Composition",
        "description": "What the model wrote, and which model it was."
      },
      "DeleteParams": {
        "properties": {
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "id of the message to delete, as read or publish gave it"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "id"
        ],
        "title": "DeleteParams",
        "description": "Which message on which platform."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Handled": {
        "properties": {
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepResult"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule",
          "platform",
          "message_id",
          "ok",
          "steps"
        ],
        "title": "Handled",
        "description": "One rule run on one message, and how its steps went."
      },
      "InboxParams": {
        "properties": {
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform",
            "description": "only this platform (a hook is hook:<name>)"
          },
          "limit": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InboxParams",
        "description": "Which messages of the inbox, and how many."
      },
      "Message": {
        "properties": {
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Account"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply To"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "text"
        ],
        "title": "Message",
        "description": "Something said on a platform: a published post, a chat line, a hook event."
      },
      "NoParams": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "NoParams",
        "description": "For a method that takes nothing."
      },
      "NotifyParams": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "links": {
            "items": {
              "type": "string"
            },
            "type": "array",
