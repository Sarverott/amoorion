{
    // Terminal > Run Task…; each one a task of Taskfile.yml.
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "check (everything CI does)",
            "type": "shell",
            "command": "uv run task check",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "format",
            "type": "shell",
            "command": "uv run task format",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "format this file",
            "type": "shell",
            "command": "uv run task format -- '${file}'",
            "problemMatcher": []
        },
        {
            "label": "notebooks: refresh all",
            "type": "shell",
            "command": "uv run task examples:refresh",
            "problemMatcher": []
        },
        {
            "label": "notebooks: refresh this one",
            "type": "shell",
            "command": "uv run task examples:refresh -- '${file}'",
            "problemMatcher": []
        },
        {
            "label": "docs: build",
            "type": "shell",
            "command": "uv run task docs:build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "state of development",
            "type": "shell",
            "command": "uv run task state",
            "problemMatcher": []
        }
    ]
}
