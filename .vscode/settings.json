{
    // The environment of `uv sync`.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "jupyter.notebookFileRoot": "${fileDirname}",

    // Saving formats with ruff, which keeps the open shape once it is there;
    // `task format` (or the task "format") also adds the commas and blank lines.
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,

    // Build results, not to search through.
    "search.exclude": {
        "**/_build": true,
        "examples/build": true,
        "site": true,
        "tools/node_modules": true
    }
}
