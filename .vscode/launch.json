{
    // Run and Debug (F5): the same entry points as the terminal, under the debugger.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Current file with arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "amoorion (asks what to do)",
            "type": "debugpy",
            "request": "launch",
            "module": "amoorion",
            "console": "integratedTerminal"
        },
        {
            "name": "amoorion with arguments",
            "type": "debugpy",
            "request": "launch",
            "module": "amoorion",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "HTTP API on 127.0.0.1:8000",
            "type": "debugpy",
            "request": "launch",
            "module": "amoorion",
            "console": "integratedTerminal",
            "args": ["api"]
        },
        {
            "name": "Notebooks: refresh all",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/refresh-examples.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Notebook: refresh this one",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/refresh-examples.py",
            "console": "integratedTerminal",
            "args": ["${file}"]
        },
        {
            "name": "Tests of the current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "args": ["${file}", "-q"]
        }
    ]
}
