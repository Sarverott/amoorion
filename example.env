# Copy to .env. Only the link to the vault lives here, never the platform
# secrets themselves (see src/amoorion/vault/base.py and docs/structure.md).

# Bitwarden / Vaultwarden: `bw login`, then the session of `bw unlock --raw`
AMOORION_VAULT=bitwarden
AMOORION_VAULT_TOKEN=
# AMOORION_VAULT_ADDR=https://vault.example.org   # refuse if bw talks to another server
# AMOORION_VAULT_PATH=amoorion                    # item names: <path>/<platform>

# HashiCorp Vault / OpenBao
# AMOORION_VAULT=http
# AMOORION_VAULT_ADDR=https://vault.example.org
# AMOORION_VAULT_TOKEN=
# AMOORION_VAULT_PATH=secret/amoorion             # <mount>/<prefix>

# KeePassXC (needs `uv sync --extra keepassxc`)
# AMOORION_VAULT=keepassxc
# AMOORION_VAULT_PATH=/path/to/secrets.kdbx
# AMOORION_VAULT_TOKEN=                           # master password

# Development: secrets as AMOORION_SECRET_<PLATFORM>_<KEY> variables
# AMOORION_VAULT=env

# Where the inbox of received messages is kept (SQLite); default
# $XDG_DATA_HOME/amoorion/inbox.sqlite3
# AMOORION_INBOX=~/.local/share/amoorion/inbox.sqlite3
