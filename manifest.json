{
  "name": "amoorion",
  "version": "0.4.36",
  "repository": "https://github.com/Sarverott/amoorion",
  "docs": "https://amoorion.readthedocs.io/",
  "openapi": "openapi.json",
  "packages": {
    "amoorion": "0.4.36",
    "amoorion-blogger": "0.4.4",
    "amoorion-bluesky": "0.4.5",
    "amoorion-discord": "0.4.5",
    "amoorion-email": "0.4.10",
    "amoorion-facebook": "0.4.4",
    "amoorion-mastodon": "0.4.6",
    "amoorion-matrix": "0.4.5",
    "amoorion-ntfy": "0.4.8",
    "amoorion-telegram": "0.4.5",
    "amoorion-tumblr": "0.4.5",
    "amoorion-x": "0.4.6"
  },
  "platforms": [
    {
      "name": "blogger",
      "description": "Blogger by mail: post",
      "capabilities": [
        "post"
      ]
    },
    {
      "name": "bluesky",
      "description": "Bluesky (AT Protocol): post, read, reply, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "discord",
      "description": "Discord bot in one channel (REST API): post, read, reply, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "discord-webhook",
      "description": "Discord channel webhook, no bot: post, delete what it posted",
      "capabilities": [
        "delete",
        "post"
      ]
    },
    {
      "name": "dryrun",
      "description": "sends nothing; remembers posts for the running process",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "email",
      "description": "E-mail: send by SMTP, read by IMAP, reply",
      "capabilities": [
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "facebook",
      "description": "Facebook Page (Graph API): post, read, reply as comment, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "mastodon",
      "description": "Mastodon (REST API): post, read, reply, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "matrix",
      "description": "Matrix room (client-server API): post, read, reply, delete (redact)",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "ntfy",
      "description": "ntfy: push notifications to one topic, and read them",
      "capabilities": [
        "post",
        "read"
      ]
    },
    {
      "name": "telegram",
      "description": "Telegram bot in one chat (Bot API): post, read, reply, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    },
    {
      "name": "tumblr",
      "description": "Tumblr API v2: post, read, delete",
      "capabilities": [
        "delete",
        "post",
        "read"
      ]
    },
    {
      "name": "x",
      "description": "X (twitter) API v2: post, read, reply, delete",
      "capabilities": [
        "delete",
        "post",
        "read",
        "reply"
      ]
    }
  ],
